---
import Layout from "../layouts/Layout.astro";

const repo = "https://github.com/m4rocks/claudiu";
---

<Layout
	title="Claudiu"
	description="A workspace for your Claude Code sessions."
>
	<header class="flex shrink-0 items-center gap-3 px-6 py-4">
		<img src="/claudiu.svg" alt="" class="h-5" />
		<span class="font-semibold tracking-wide text-white">Claudiu</span>
	</header>

	<main
		class="flex min-h-0 flex-1 flex-col items-center px-6 pt-4 pb-6 text-center"
	>
		<img src="/claudiu.svg" alt="Claudiu mascot" class="h-14 shrink-0" />
		<h1 class="mt-4 text-3xl font-semibold text-white">Claudiu</h1>
		<p class="mt-3 text-neutral-400">
			A workspace for your Claude Code sessions.
		</p>

		<div class="mt-5 flex shrink-0 gap-3">
			<a
				href={`${repo}/releases/latest`}
				class="rounded-md bg-claude px-5 py-2 text-sm font-medium text-black hover:brightness-110"
			>
				Download
			</a>
			<a
				href={repo}
				class="rounded-md bg-neutral-900 px-5 py-2 text-sm font-medium text-neutral-200 hover:bg-neutral-800"
			>
				GitHub
			</a>
		</div>

		<img
			src="/screenshot.png"
			alt="Claudiu app screenshot"
			class="mt-6 min-h-0 max-w-full flex-1 rounded-lg border border-neutral-800 object-contain"
		/>

		<a href="https://m4.rocks" class="text-neutral-400 underline mt-8">
			Made with &hearts; by @m4rocks
		</a>
	</main>
</Layout>
