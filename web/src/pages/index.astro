---
import Layout from "../layouts/Layout.astro";

const repo = "https://github.com/m4rocks/claudiu";
---

<Layout
    title="Claudiu — a desktop app for juggling Claude Code sessions"
    description="Claudiu runs your own Claude Code CLI in a real terminal and keeps your projects, running sessions and usage meters in one native window, on Windows and macOS."
>
    <header class="mx-auto flex w-full max-w-6xl items-center justify-between px-6 py-5 sm:px-8">
        <a href="/" class="flex items-center gap-2.5">
            <img src="/claudiu.svg" alt="" class="h-3.75 w-auto" />
            <span class="font-mono text-[12px] font-medium tracking-[0.16em] text-neutral-200">
                CLAUDIU
            </span>
        </a>

        <nav class="flex items-center gap-7 font-mono text-[12px] text-neutral-400">
            <a
                href={`${repo}/releases`}
                class="transition-colors hover:text-neutral-100"
            >
                Releases
            </a>
            <a href={repo} class="transition-colors hover:text-neutral-100">
                GitHub
            </a>
        </nav>
    </header>

    <main class="mx-auto flex w-full max-w-6xl flex-1 flex-col justify-center px-6 pt-10 pb-16 sm:px-8 lg:py-20">
        <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-[minmax(0,25rem)_minmax(0,1fr)] lg:gap-14 xl:grid-cols-[minmax(0,27rem)_minmax(0,1fr)]">
            <div class="min-w-0">
                <h1 class="text-balance font-serif text-[2.35rem] leading-[1.08] tracking-[-0.015em] text-neutral-100 sm:text-5xl">
                    A desktop app for juggling Claude Code sessions.
                </h1>

                <p class="mt-6 max-w-132 text-[15px] leading-7 text-neutral-400">
                    Claudiu runs your own{" "}
                    <code class="font-mono text-[0.9em] text-neutral-200">
                        claude
                    </code>{" "}
                    in a real terminal, and keeps your projects, running
                    sessions, accounts and usage meters in one native window.
                </p>

                <div class="mt-8 flex flex-wrap items-center gap-3">
                    <a
                        href={`${repo}/releases/latest`}
                        class="rounded-md bg-claude px-5 py-2.5 text-sm font-medium text-[#1b0f0a] transition-colors hover:bg-[#e0826a] active:translate-y-px"
                    >
                        Download
                    </a>
                    <a
                        href={repo}
                        class="rounded-md border border-line px-5 py-2.5 text-sm font-medium text-neutral-300 transition-colors hover:border-neutral-600 hover:text-neutral-100 active:translate-y-px"
                    >
                        View on GitHub
                    </a>
                </div>

                <p class="mt-5 font-mono text-[11px] text-neutral-400">
                    Windows &amp; macOS · No API key or login
                </p>
            </div>

            <figure class="min-w-0 lg:-mr-4">
                <div class="overflow-hidden rounded-lg border border-line bg-ink-raised p-1.5 shadow-[0_24px_70px_-30px_rgba(0,0,0,1)]">
                    <img
                        src="/screenshot.png"
                        alt="The Claudiu window: a sidebar of projects and running sessions beside a terminal."
                        width="1272"
                        height="796"
                        class="block w-full max-w-full rounded-sm"
                    />
                </div>
            </figure>
        </div>
    </main>

    <footer class="mx-auto flex w-full max-w-6xl items-center justify-between px-6 py-5 font-mono text-[11px] text-neutral-400 sm:px-8">
        <a
            href="https://m4.rocks"
            class="transition-colors hover:text-neutral-200"
        >
            Made with &hearts; by @m4rocks
        </a>
    </footer>
</Layout>
